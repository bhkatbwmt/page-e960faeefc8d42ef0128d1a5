22px 20px 66px;position: relative;margin-bottom: 16px}\n  .steps li::before {content: counter(step, decimal-leading-zero);position: absolute;left: 18px;top: 14px;font-size: 26px;font-weight: 900;color: var(--violet);line-height: 1}\n  .steps h3 {margin: 0 0 6px;font-size: 18px}\n  .steps p {margin: 0;color: #33343c}\n\n  /* 套餐：单列大卡依次堆叠 */\n  .plan {border: 3px solid var(--line);background: #fff;padding: 24px;margin-bottom: 24px;position: relative}\n  .plan.is-featured {background: var(--violet-soft);border-color: var(--violet);box-shadow: 10px 10px 0 var(--violet)}\n  .plan-badge {display: inline-block;font-size: 12px;letter-spacing: 0.16em;font-weight: 700;background: var(--violet);color: #fff;padding: 3px 10px;margin-bottom: 10px}\n  .plan-head {display: flex;flex-wrap: wrap;align-items: baseline;gap: 10px 18px;border-bottom: 2px dashed #c3c6cf;padding-bottom: 12px;margin-bottom: 14px}\n  .plan-head h3 {margin: 0;font-size: 24px;letter-spacing: -0.02em}\n  .price {font-size: 30px;font-weight: 900;letter-spacing: -0.03em}\n  .price small {font-size: 14px;font-weight: 500;color: var(--muted)}\n  .plan-annual {font-size: 14px;color: var(--violet);font-weight: 700}\n  .plan ul {list-style: none;margin: 0;padding: 0}\n  .plan ul li {padding: 7px 0 7px 26px;border-bottom: 1px dashed #e2e4e9;position: relative}\n  .plan ul li:last-child {border-bottom: 0}\n  .plan ul li::before {content: \"\";position: absolute;left: 4px;top: 17px;width: 9px;height: 9px;background: var(--violet)}\n  .plan-foot {margin-top: 14px;font-size: 13px;color: var(--muted)}\n\n  /* 客户端 */\n  .clients {display: grid;gap: 18px;grid-template-columns: 1fr}\n  @media (min-width: 720px) {\n    .clients {grid-template-columns: 1fr 1fr}\n  }\n  .clients .card {margin-bottom: 0}\n  .clients .card h3 small {display: block;font-size: 12px;letter-spacing: 0.18em;color: var(--violet);font-weight: 700;margin-bottom: 4px}\n\n  /* FAQ：details 折叠 */\n  .faq-group {border: 3px solid var(--line);background: #fff;padding: 8px 20px 18px;margin-bottom: 20px}\n  .faq-group > h3 {font-size: 16px;letter-spacing: 0.12em;text-transform: uppercase;color: var(--violet);margin: 14px 0 6px}\n  details {border-bottom: 2px dashed #d6d8df;padding: 4px 0}\n  details:last-child {border-bottom: 0}\n  summary {cursor: pointer;list-style: none;font-weight: 700;font-size: 16.5px;padding: 12px 30px 12px 0;position: relative}\n  summary::-webkit-details-marker {display: none}\n  summary::after {content: \"+\";position: absolute;right: 0;top: 8px;font-size: 22px;font-weight: 900;color: var(--violet);line-height: 1}\n  details[open] summary::after {content: \"–\"}\n  details p {margin: 0 0 14px;color: #33343c}\n\n  .foot {border-top: 3px solid var(--line);margin-top: 60px;padding: 22px 0 40px;font-size: 13px;color: var(--muted)}\n  .foot strong {color: var(--ink)}\n\n  .inline-link {color: var(--violet);font-weight: 700;text-decoration: none;border-bottom: 2px solid var(--violet)}\n  .inline-link:hover {color: var(--ink);border-color: var(--ink)}\n</style><div class=\"shell\">\n\n  <aside class=\"rail\">\n    <a class=\"rail-brand\" href=\"#top\">me<span>.</span></a>\n    <p class=\"rail-label\">本页目录</p>\n    <nav aria-label=\"页面目录\">\n      <ul>\n        <li><a href=\"#how-to\"><span class=\"num\">01</span>怎么开始用</a></li>\n        <li><a href=\"#plans\"><span class=\"num\">02</span>三档方案</a></li>\n        <li><a href=\"#clients\"><span class=\"num\">03</span>客户端怎么选</a></li>\n        <li><a href=\"#faq\"><span class=\"num\">04</span>常见问题</a></li>\n      </ul>\n    </nav>\n    <div class=\"rail-note\">\n      价格与权益都在正文里写清楚了，往下翻就行。有拿不准的地方，先看看常见问题那一段。\n    </div>\n  </aside>\n\n  <main id=\"top\">\n\n    <header class=\"poster\">\n      <p class=\"poster-kicker\">订阅方案 · 使用说明</p>\n      <h1>me<span class=\"dot\">.</span></h1>\n      <div class=\"poster-sub\">\n        <p>先别急着挑最贵的。这一页想做的事很简单：把每档方案给你多少东西、你该怎么用、遇到问题去哪里翻答案，一次讲清楚。</p>\n        <span class=\"tag\">三档方案 · 单列看个明白</span>\n      </div>\n      <div class=\"poster-facts\">\n        <div>\n          <strong>¥15 起 / 月</strong>\n          <span>基础版起步价</span>\n        </div>\n        <div>\n          <strong>3 台起</strong>\n          <span>最低同时在线设备数</span>\n        </div>\n        <div>\n          <strong>100GB 起</strong>\n          <span>最低每月流量额度</span>\n        </div>\n      </div>\n    </header>\n\n    <section id=\"how-to\">\n      <div class=\"sec-head\">\n        <h2>怎么开始用</h2>\n        <p>四步走，不用研究半天。每一步都写的是你实际要做的事，没有玄学设置。</p>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <h3>先想清楚自己要多少流量</h3>\n          <p>拿上个月的用量做参照：只刷网页和聊天，基础版的一百 GB 基本够了；每天要看片、开会、传文件，往旗舰版看；如果是几个人一起用，团队版才是正经答案。别为了“以防万一”买大一档，用完再升也不迟。</p>\n        </li>\n        <li>\n          <h3>挑一档，记下对应的设备数</h3>\n          <p>基础版三台、旗舰版五台、团队版二十台。这里的“台”指的是同时在线，不是总共能登记多少台。手边经常一起开的手机、电脑、平板数一遍，心里就有数了。</p>\n        </li>\n        <li>\n          <h3>在设备上装一个客户端</h3>\n          <p>电脑和手机各有各的客户端，具体怎么选见下面客户端那一段。装之前先确认系统版本，太老的系统可能会卡在安装这一步。</p>\n        </li>\n        <li>\n          <h3>连上之后先做个小测试</h3>\n          <p>打开两三个平时最常用的网页，看看加载顺不顺；需要看片的，就随便点开一集试试。哪里不对劲，记下时间点和设备型号，再去翻常见问题，比空口描述“连不上”有用得多。</p>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"sec-head\">\n        <h2>三档方案，按顺序摊开</h2>\n        <p>不并排放表格，是因为并排容易看串行。一档一档往下看，看完一档再决定要不要往下一档走。年付价格都是按整年一次性支付的总额。</p>\n      </div>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>基础版</h3>\n          <span class=\"price\">¥15<small> / 月</small></span>\n          <span class=\"plan-annual\">按年付仅需 ¥150 / 年</span>\n        </div>\n        <ul>\n          <li>每月 100GB 流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>可解锁基础流媒体</li>\n          <li>使用普通线路节点池</li>\n        </ul>\n        <p class=\"plan-foot\">适合一个人、以日常浏览和偶尔看片为主的情况。</p>\n      </article>\n\n      <article class=\"plan is-featured\">\n        <span class=\"plan-badge\">多数人会选这档</span>\n        <div class=\"plan-head\">\n          <h3>旗舰版</h3>\n          <span class=\"price\">¥35<small> / 月</small></span>\n          <span class=\"plan-annual\">按年付仅需 ¥350 / 年</span>\n        </div>\n        <ul>\n          <li>每月 300GB 流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线，针对游戏加速做过优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <p class=\"plan-foot\">设备多、看片多、还在意延迟的话，这一档的余量更舒服。</p>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>团队版</h3>\n          <span class=\"price\">¥85<small> / 月</small></span>\n          <span class=\"plan-annual\">按年付仅需 ¥850 / 年</span>\n        </div>\n        <ul>\n          <li>每月 1000GB 流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理对接</li>\n        </ul>\n        <p class=\"plan-foot\">几个同事或一家人共用一个池子时用，配额足够分摊。</p>\n      </article>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"sec-head\">\n        <h2>客户端怎么选</h2>\n        <p>按你手头最主要的设备来挑，不用每台都装一遍。目前没有可提供的安装包下载地址，具体获取方式请以你购买后收到的说明为准。</p>\n      </div>\n      <div class=\"clients\">\n        <article class=\"card\">\n          <h3><small>电脑端</small>桌面客户端</h3>\n          <p>适合长时间坐在电脑前的人。装好之后一般常驻在任务栏或菜单栏，切换线路比在网页上点来点去快。系统版本偏旧的话，建议先更新系统再装。</p>\n        </article>\n        <article class=\"card\">\n          <h3><small>手机端</small>移动客户端</h3>\n          <p>出门在外的主力。手机端更看重省电和切换稳定，建议只在你真的会用的那台手机上装，别为了凑设备数把旧手机也挂上去。iOS 与 Android 的安装方式不同，按购买后的说明操作。</p>\n        </article>\n        <article class=\"card\">\n          <h3><small>路由 / 多设备</small>共享方案</h3>\n          <p>如果家里设备很多，考虑把连接放在路由层面统一处理，这样电视、平板、游戏机都能共用一份配额。团队版支持定制路由，这一层需要和客户经理先聊清楚再动手。</p>\n        </article>\n        <article class=\"card\">\n          <h3><small>先别装</small>这些情况可以缓一缓</h3>\n          <p>只是偶尔查个资料、主要在公司网络里活动，或者设备系统已经停止更新很久——这几种情况装上去体验未必好，先把需求理清再决定，不着急。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <p>下面几条是问得最多的。点开标题看答案，看完还糊涂，就带着具体信息去提工单。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>选方案</h3>\n        <details>\n          <summary>我到底该买基础版还是旗舰版？</summary>\n          <p>看你一个月大概用多少流量、同时开几台设备。一个人日常浏览为主，基础版的 100GB 和三台设备通常够用；如果经常看片、设备超过三台、或者打游戏在意延迟，旗舰版的 300GB、五台设备和专线优化更合适。不确定就先从基础版开始，用满再升。</p>\n        </details>\n        <details>\n          <summary>年付划算在哪里，可以中途换档吗？</summary>\n          <p>年付就是把十二个月的钱一次付清，页面上的年付总额分别是 ¥150、¥350、¥850。是否支持中途换档，我们不在这一页做出承诺，请在下单前通过工单确认，避免两边理解不一致。</p>\n        </details>\n        <details>\n          <summary>“同时在线设备数”是怎么算的？</summary>\n          <p>算的是同一时刻正在连着的设备数量。基础版三台、旗舰版五台、团队版二十台。你今天用电脑、晚上换手机，这不算两台同时在用，只要不是同一时刻一起连着就行。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>用起来</h3>\n        <details>\n          <summary>连上了但网页打不开，先查什么？</summary>\n          <p>按顺序来：先看客户端是不是显示已连接；再换一个线路试试，排除单个节点的问题；然后确认是不是只有某一个网站打不开，还是全都打不开。全都打不开多半是本地网络或客户端状态的问题，只有个别网站打不开则更可能是线路选择的问题。</p>\n        </details>\n        <details>\n          <summary>看视频卡，是不是流量不够？</summary>\n          <p>不一定。流量不够通常表现为额度用尽后无法继续，而卡顿更可能和线路、当前时段、设备性能有关。基础版用的是普通线路节点池，旗舰版有专线优化，如果你长期在看片时段觉得吃力，先换线路试，再考虑升档。</p>\n        </details>\n        <details>\n          <summary>团队版的“定制路由”要提前准备什么？</summary>\n          <p>先把使用人数、主要设备类型、希望覆盖的场景列出来，交给对接的客户经理。这一项需要沟通后再落地，不是勾选一下就自动生效，所以建议预留一点时间，别等到要用当天才提。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>账户与其他</h3>\n        <details>\n          <summary>遇到问题应该走哪个渠道？</summary>\n          <p>旗舰版提供 7×24 优先工单支持，团队版有专属客户经理；基础版也走工单。提工单时把设备型号、系统版本、出问题的时间点和具体现象写清楚，处理起来会快很多。</p>\n        </details>\n        <details>\n          <summary>这一页上的价格是最终价格吗？</summary>\n          <p>页面上列出的月付与年付金额就是我们当前展示的方案价格，没有别的隐藏项写在别处。如果你看到的价格与此不同，请以你下单时页面实际显示的为准，并先向工单确认。</p>\n        </details>\n      </div>\n    </section>\n\n    <footer class=\"foot\">\n      <p><strong>me.</strong> 这一页只讲方案、步骤和问题处理，不讲你没问过的事。方案内容以本页展示为准。</p>\n    </footer>\n\n  </main>\n</div>",
